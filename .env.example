# Copy to .env (git-ignored). Leave empty for local-only mode.
# Supabase project URL and the PUBLIC anon key only (never the service-role key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set to "false" to force local-only mode even when the values above are present.
VITE_ENABLE_CLOUD=true
# Show AI food-photo estimates (requires the estimate-nutrition edge function
# deployed with OPENAI_API_KEY set as a function secret — see docs/SETUP.md).
VITE_ENABLE_AI_NUTRITION=false
